{
  "arazzo": "1.0.1",
  "info": {
    "title": "Illustrative customer activation work order",
    "version": "0.1.0",
    "description": "Agent-authored proposal for separate application validation and human approval. No live service."
  },
  "sourceDescriptions": [
    {
      "name": "customerService",
      "url": "openapi.json",
      "type": "openapi"
    }
  ],
  "workflows": [
    {
      "workflowId": "activateWithReporting",
      "summary": "Configure billing, activate standard service, enable reporting",
      "description": "Approved fictional method: execute in order. Application must enforce eligibility and ownership; authoring agent cannot execute.",
      "inputs": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "customerId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "customerId"
        ]
      },
      "steps": [
        {
          "stepId": "configureBilling",
          "operationId": "configureBilling",
          "parameters": [
            {
              "name": "customerId",
              "in": "path",
              "value": "$inputs.customerId"
            }
          ],
          "requestBody": {
            "contentType": "application/json",
            "payload": {
              "cycle": "monthly"
            }
          },
          "successCriteria": [
            {
              "condition": "$statusCode == 200"
            }
          ],
          "outputs": {
            "billingRecordId": "$response.body#/billingRecordId"
          }
        },
        {
          "stepId": "activateService",
          "operationId": "activateService",
          "parameters": [
            {
              "name": "customerId",
              "in": "path",
              "value": "$inputs.customerId"
            }
          ],
          "requestBody": {
            "contentType": "application/json",
            "payload": {
              "package": "standard",
              "billingRecordId": "$steps.configureBilling.outputs.billingRecordId"
            }
          },
          "successCriteria": [
            {
              "condition": "$statusCode == 200"
            }
          ],
          "outputs": {
            "serviceId": "$response.body#/serviceId"
          }
        },
        {
          "stepId": "enableReporting",
          "operationId": "enableReporting",
          "parameters": [
            {
              "name": "customerId",
              "in": "path",
              "value": "$inputs.customerId"
            }
          ],
          "requestBody": {
            "contentType": "application/json",
            "payload": {
              "serviceId": "$steps.activateService.outputs.serviceId",
              "enabled": true
            }
          },
          "successCriteria": [
            {
              "condition": "$statusCode == 200"
            },
            {
              "condition": "$response.body#/reportingEnabled == true"
            }
          ]
        }
      ]
    }
  ]
}
